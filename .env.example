# Supabase — exposées au client par Vite (le préfixe VITE_ est OBLIGATOIRE,
# sinon Vite ne les injecte pas dans le build et l'app affiche "Configuration manquante").
#
# Local : copier ce fichier en `.env` puis remplir avec les valeurs de
#   Supabase > Project Settings > API (Project URL + anon public key).
# Netlify : définir ces deux variables dans Site settings > Environment variables,
#   puis relancer un déploiement (les variables Vite sont injectées au moment du build).

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique
